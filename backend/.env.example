# Supabase PostgreSQL
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.user
DB_PASS=your-password

# Server
PORT=3001

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=2h

# CORS (comma-separated origins, e.g. https://frontend.onrender.com)
CORS_ORIGIN=https://debit-web.onrender.com

# Gmail (movimientos de tarjetas por correo)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Debe coincidir exactamente con un URI de redireccionamiento autorizado en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback
# 64 caracteres hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_KEY=
# A dónde vuelve el navegador tras el callback (frontend)
FRONTEND_URL=http://localhost:5174
